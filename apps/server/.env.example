# Copy to apps/server/.env and adjust. Never commit the real .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://leash:leash_dev_password@localhost:5433/leash
# Used only by integration tests. Must point at a throwaway database.
TEST_DATABASE_URL=postgresql://leash:leash_dev_password@localhost:5433/leash_test

# Origin of the web dashboard (used for future CSRF/origin checks).
WEB_ORIGIN=http://localhost:5173

# Sessions: absolute lifetime and idle timeout.
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720

# --- PayPal (backend only; never exposed to agents or the browser) ---
# Only "sandbox" is accepted. The server refuses to start with anything else.
PAYPAL_ENV=sandbox
# Not needed until Phase 7. Create sandbox REST app credentials at developer.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Anthropic (backend only; never sent to agents or the browser) ---
# Required from Phase 4 to compile policies. Everything else in Leash works without it.
ANTHROPIC_API_KEY=
# Model IDs are deliberately not defaulted. Use exact IDs from Anthropic's model documentation
# or the Models API (GET https://api.anthropic.com/v1/models).
# Stronger model, used rarely (only when a user compiles a policy). Must support structured outputs.
LLM_MODEL_POLICY_COMPILER=
# Cost-effective, low-latency model for intent verification and injection classification.
# Without it (or the key), every purchase the policy allows is ESCALATED for human approval (fail closed).
LLM_MODEL_CLASSIFIER=
# Optional. Per-call timeout for the classifier and intent verifier, in ms (1000-60000). No retries.
# (Timeout + 2s) x 2 must not exceed EVALUATION_TIMEOUT_SECONDS.
LLM_CLASSIFIER_TIMEOUT_MS=8000
# Optional. low|medium|high|xhigh|max. Leave empty unless the classifier model supports `effort`.
LLM_CLASSIFIER_EFFORT=
# Optional. Request timeout for policy compilation, in milliseconds (5000-300000).
LLM_POLICY_COMPILER_TIMEOUT_MS=60000
# Optional. low|medium|high|xhigh|max. Leave empty unless the compiler model supports `effort`.
LLM_POLICY_COMPILER_EFFORT=

# --- Limits (may be tightened, never loosened past the approved caps) ---
# How long an ESCALATED purchase waits for approval (funds held) before it expires and funds are released.
APPROVAL_TTL_MINUTES=60
# How long an ALLOWED purchase stays authorized (funds held) before it expires unpaid.
AUTHORIZATION_TTL_MINUTES=30
# A purchase still being evaluated after this many seconds is expired and its reserved funds
# released (30-3600). The sweep that enforces it runs every RESERVATION_SWEEP_INTERVAL_SECONDS (5-3600).
EVALUATION_TIMEOUT_SECONDS=120
RESERVATION_SWEEP_INTERVAL_SECONDS=30
# $500.00 in cents. Values above 50000 are rejected.
SANDBOX_MAX_TRANSACTION_MINOR=50000
